FLAGSHIP_JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FLAGSHIP_EVIDENCE_SIGNING_SECRET=replace-with-a-distinct-random-secret-of-at-least-32-characters
POSTGRES_OWNER_PASSWORD=replace-with-owner-secret
POSTGRES_APP_PASSWORD=replace-with-distinct-runtime-secret
FLAGSHIP_DATABASE_URL=postgresql+psycopg://flagship_app:replace-with-distinct-runtime-secret@postgres:5432/flagship
FLAGSHIP_BACKUP_KEY_BASE64=replace-with-a-base64-encoded-32-byte-key
# Production identity (configure all three; do not enable dev tokens)
FLAGSHIP_OIDC_ISSUER=https://identity.example.com
FLAGSHIP_OIDC_AUDIENCE=flagship-api
FLAGSHIP_OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
# Ed25519 private key mounted as a read-only secret file
FLAGSHIP_EVIDENCE_PRIVATE_KEY_FILE=/run/secrets/evidence-signing-key.pem
FLAGSHIP_EVIDENCE_KEY_ID=local-ed25519-v1
FLAGSHIP_EVIDENCE_STORE=work/object-store
FLAGSHIP_EVIDENCE_RETENTION_DAYS=2555
OTEL_SERVICE_NAME=flagship-lab
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
